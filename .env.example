# Next.js
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (Neon Postgres) - added in Phase 2
# DATABASE_URL=postgresql://user:password@host/dbname

# Email (Hostinger SMTP) - added in Phase 2
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=your-email@domain.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@domain.com
# RFQ_EMAIL_TO=sales@sahcompany.com
# RFQ_EMAIL_CC=info@sahcompany.com

# Cloudinary - added in Phase 2
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Auth.js - added in Phase 2
# NEXTAUTH_SECRET=your-secret-key-here
# NEXTAUTH_URL=http://localhost:3000

# Admin user seed (one-time setup) - added in Phase 2
# ADMIN_EMAIL=admin@example.com
# ADMIN_INITIAL_PASSWORD=ChangeMe!123
